# Supabase project settings (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Comma-separated list of emails allowed into /admin/dashboard.
# Must match the emails used to sign in via Supabase magic link.
ADMIN_EMAILS=you@example.com,monarch@example.com

# Twitch channel to embed/link on the bracket page (no twitch.tv/ prefix).
NEXT_PUBLIC_TWITCH_CHANNEL=mistartworks
